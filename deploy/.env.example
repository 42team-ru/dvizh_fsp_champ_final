DB_PASSWORD=change-me
# Подпись JWT, минимум 32 символа. На сервере CI создаёт его сам, если нет.
# DEMO_MODE=true включает тестовые аккаунты с публичным паролем и кнопки быстрого входа (только для демо!)
JWT_SECRET=change-me-to-a-long-random-string-32+
# Пусто/":80" = HTTP по IP. Для HTTPS укажите домен, A-запись должна смотреть на VPS.
# Пароль S3 (MinIO), от 8 символов. На сервере CI создаёт его сам, если нет.
S3_SECRET_KEY=change-me-s3-secret
DOMAIN=:80
# Адрес сайта для ссылок в уведомлениях, например https://sport.example
APP_PUBLIC_URL=
# Telegram-бот уведомлений (docs/notifications.md). Секрет webhook: openssl rand -hex 32
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Модерация текстов: нейросеть (сервис llm, ~1 ГБ памяти) и классификатор токсичности (сервис toxicity); docs/moderation.md. false — без этого голоса
MODERATION_LLM_ENABLED=true
MODERATION_CLASSIFIER_ENABLED=true
