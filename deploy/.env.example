DB_PASSWORD=change-me
# Подпись JWT, минимум 32 символа. На сервере CI создаёт его сам, если нет.
# DEMO_MODE=true включает тестовые аккаунты с публичным паролем и кнопки быстрого входа (только для демо!)
JWT_SECRET=change-me-to-a-long-random-string-32+
# Пусто/":80" = HTTP по IP. Для HTTPS укажите домен, A-запись должна смотреть на VPS.
DOMAIN=:80
