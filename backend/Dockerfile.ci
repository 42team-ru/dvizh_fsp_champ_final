# Тонкий образ для CI: jar уже собран в Actions (build/libs/app.jar).
# Слоёный экстракт (рекомендация Spring Boot): зависимости (~65 МБ) — отдельный слой, который почти не меняется,
# слой с кодом ~20 КБ. Поэтому `docker pull` на VPS при обычном деплое скачивает считанные килобайты.
FROM eclipse-temurin:25-jre-alpine AS extract
WORKDIR /x
COPY build/libs/app.jar application.jar
RUN java -Djarmode=tools -jar application.jar extract --layers --destination extracted

FROM eclipse-temurin:25-jre-alpine
WORKDIR /srv
COPY --from=extract /x/extracted/dependencies/ ./
COPY --from=extract /x/extracted/spring-boot-loader/ ./
COPY --from=extract /x/extracted/snapshot-dependencies/ ./
COPY --from=extract /x/extracted/application/ ./
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+UseSerialGC"
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "application.jar"]
