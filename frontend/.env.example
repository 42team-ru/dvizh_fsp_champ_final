# Адрес бэкенда.
# Используется: прокси /api в vite dev и `yarn api:pull` (скачивание OpenAPI-спеки).
VITE_BACKEND_URL=http://localhost:8080

# Необязательно: полный URL спеки, если она лежит не в ${VITE_BACKEND_URL}/v3/api-docs
# API_SPEC_URL=

# Карта 2ГИС: параметры из корневого .env читают dev-сервер и docker compose.
# Здесь можно переопределить для себя, значение отсюда главнее корневого:
# VITE_2GIS_KEY=
# raster | mapgl (по умолчанию raster); ?map=mapgl|raster перекрывает env.
# MapGL требует доступа к MapGL JS API у ключа в кабинете 2ГИС; RasterJS нужен для fallback.
# VITE_2GIS_MAP=raster
# Только MapGL, пусто — стандартный стиль:
# styles.2gis.com → Мои стили → Поделиться → Идентификатор стиля.
# VITE_2GIS_STYLE_ID=
