# Адрес бэкенда.
# Используется: прокси /api в vite dev и `yarn api:pull` (скачивание OpenAPI-спеки).
VITE_BACKEND_URL=http://localhost:8080

# Необязательно: полный URL спеки, если она лежит не в ${VITE_BACKEND_URL}/v3/api-docs
# API_SPEC_URL=

# Ключ 2ГИС MapGL (карта событий и выбор точки)
VITE_2GIS_KEY=

# Необязательно: свой стиль из редактора стилей 2ГИС (схема без значков организаций)
VITE_2GIS_STYLE_ID=
