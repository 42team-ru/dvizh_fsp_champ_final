# Адрес бэкенда.
# Используется: прокси /api в vite dev и `yarn api:pull` (скачивание OpenAPI-спеки).
VITE_BACKEND_URL=http://localhost:8080

# Необязательно: полный URL спеки, если она лежит не в ${VITE_BACKEND_URL}/v3/api-docs
# API_SPEC_URL=

# Ключ 2ГИС MapGL (карта событий и выбор точки) и необязательный свой стиль задаются в корневом .env
# (VITE_2GIS_KEY, VITE_2GIS_STYLE_ID): оттуда их берут и dev-сервер, и docker compose.
# Здесь можно переопределить для себя, значение отсюда главнее корневого:
# VITE_2GIS_KEY=
# VITE_2GIS_STYLE_ID=
