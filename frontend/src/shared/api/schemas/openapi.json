    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "auth_logout",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sports": {
      "get": {
        "tags": [
          "sports"
        ],
        "summary": "Виды спорта",
        "description": "Без query — весь справочник по алфавиту; с query — поиск по подстроке без учёта регистра, пробелов и ё/е.",
        "operationId": "sports_search",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Часть названия",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "фут"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SportResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/registrations/mine": {
      "get": {
        "tags": [
          "registrations"
        ],
        "summary": "Мои записи",
        "description": "Со статусом записи и мероприятия: снятое с публикации тоже видно.",
        "operationId": "registrations_mine",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MyRegistrationResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ping": {
      "get": {
        "tags": [
          "ping"
        ],
        "operationId": "ping",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/mine": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Мои мероприятия как организатора",
        "description": "Во всех статусах, включая снятые и удалённые.",
        "operationId": "events_mine",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventSummaryResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/accounts": {
      "get": {
        "tags": [
          "demo"
        ],
        "operationId": "demo_accounts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DemoAccountResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/users/check/username": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "auth_checkUsername",
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityCheckResponse"
                }
              }
            }
          }
        }
