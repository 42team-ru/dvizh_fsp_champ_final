{
  "openapi": "3.1.0",
  "info": {
    "title": "appAPI",
    "description": "Платформа совместных спортивных активностей. Ошибки — ProblemDetail (RFC 9457), текст для человека в поле detail.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "cookieAuth": []
    },
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "sports",
      "description": "Справочник видов спорта"
    },
    {
      "name": "registrations",
      "description": "Запись на мероприятия и решения организатора по заявкам"
    },
    {
      "name": "events",
      "description": "Мероприятия: лента, карточка, создание и редактирование"
    }
  ],
  "paths": {
    "/api/events/{id}": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Карточка мероприятия",
        "description": "Открывается в любом статусе: снятое и удалённое — с причиной. Блок viewer говорит, какие кнопки показать.",
        "operationId": "events_get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Мероприятия нет",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "events"
        ],
        "summary": "Изменить мероприятие",
        "description": "Только организатор. Заменяет все поля формы; статус и модерация не меняются.",
        "operationId": "events_update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Ошибка в форме",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Не организатор",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Мероприятия нет",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "Удалено или лимит мест меньше уже записанных",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/registrations/{id}/reject": {
      "post": {
        "tags": [
          "registrations"
        ],
        "summary": "Отклонить заявку",
        "description": "Только организатор. Можно отклонить и подтверждённого. Причину участник увидит в своей записи.",
        "operationId": "registrations_reject",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectRegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "403": {
            "description": "Не организатор (админ тоже не решает)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Заявки нет",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "Участник сам отменил запись",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/registrations/{id}/approve": {
      "post": {
        "tags": [
          "registrations"
        ],
        "summary": "Принять заявку",
        "description": "Только организатор. Можно принять и ранее отклонённую — так исправляется ошибка.",
        "operationId": "registrations_approve",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "403": {
            "description": "Не организатор (админ тоже не решает)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Заявки нет",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "Мест нет, мероприятие снято или участник сам отменил",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Лента мероприятий",
        "description": "Только опубликованные, ближайшие первыми, до 100 штук. Без from — начиная с текущего момента.",
        "operationId": "events_list",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Поиск по названию и описанию без учёта регистра",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Поиск по названию и описанию без учёта регистра",
              "example": "футбол"
            },
            "example": "футбол"
          },
          {
            "name": "sportId",
            "in": "query",
            "description": "Вид спорта",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Вид спорта"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Начало не раньше; по умолчанию — сейчас (прошедшие не показываем)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Начало не раньше; по умолчанию — сейчас (прошедшие не показываем)",
              "example": "2027-05-01T00:00:00Z"
            },
            "example": "2027-05-01T00:00:00Z"
          },
          {
            "name": "to",
            "in": "query",
            "description": "Начало не позже",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Начало не позже",
              "example": "2027-05-31T23:59:59Z"
            },
            "example": "2027-05-31T23:59:59Z"
          },
          {
            "name": "level",
            "in": "query",
            "description": "Уровень; мероприятия «Любой уровень» подходят под любой",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Уровень; мероприятия «Любой уровень» подходят под любой",
              "enum": [
                "ANY",
                "BEGINNER",
                "AMATEUR",
                "ADVANCED",
                "PRO"
              ]
            }
          },
          {
            "name": "joinMode",
            "in": "query",
            "description": "Режим записи",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Режим записи",
              "enum": [
                "FREE",
                "REQUEST"
              ]
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Очно или онлайн",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Очно или онлайн",
              "enum": [
                "OFFLINE",
                "ONLINE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventSummaryResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Создать мероприятие",
        "description": "Публикуется сразу. Вид спорта — sportId из справочника или sportName (свой, создастся без дублей).",
        "operationId": "events_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка в форме",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Администратор не создаёт мероприятия",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}/registrations": {
      "get": {
        "tags": [
          "registrations"
        ],
        "summary": "Участники и заявки мероприятия",
        "description": "Только организатору. status — необязательный фильтр, например PENDING или REJECTED.",
        "operationId": "registrations_listForEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CONFIRMED",
                "PENDING",
                "REJECTED",
                "CANCELLED"
              ]
            }
          }
        ],
        "responses": {
          "403": {
            "description": "Не организатор",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Мероприятия нет",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "registrations"
        ],
        "summary": "Записаться на мероприятие",
        "description": "FREE — сразу CONFIRMED, REQUEST — PENDING (ждёт организатора). После отмены можно записаться снова.",
        "operationId": "registrations_create",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Мероприятия нет",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "Запись закрыта: снято, уже началось, уже записан, отклонён, мест нет, своё мероприятие",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
