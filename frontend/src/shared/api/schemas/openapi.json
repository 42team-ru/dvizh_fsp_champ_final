            "minimum": 1
          },
          "joinMode": {
            "type": "string",
            "enum": [
              "FREE",
              "REQUEST"
            ]
          },
          "privateDetails": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          }
