    "/api/events/{id}/registrations/me": {
      "delete": {
        "tags": [
          "registrations"
        ],
        "summary": "Отменить свою запись",
        "description": "Место освобождается. Повторная отмена ничего не меняет (200).",
        "operationId": "registrations_cancel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Мероприятия нет или я не записан",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "Заявка отклонена или мероприятие уже началось",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventRequest": {
        "type": "object",
        "description": "Форма мероприятия: создание и полная замена при редактировании",
        "properties": {
          "title": {
            "type": "string",
            "description": "Название",
            "example": "Футбол в парке Горького",
            "maxLength": 200,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "description": "Описание",
            "example": "Играем 5 на 5, мяч есть",
            "maxLength": 5000,
            "minLength": 0
          },
          "sportId": {
            "type": "string",
            "format": "uuid",
            "description": "Вид спорта из справочника; не указывать вместе с sportName"
          },
          "sportName": {
            "type": "string",
            "description": "Свой вид спорта, если в справочнике нет; не указывать вместе с sportId",
            "example": "Петанк",
            "maxLength": 100,
            "minLength": 0
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "description": "Начало, в будущем",
            "example": "2027-05-01T16:00:00Z"
          },
          "endAt": {
            "type": "string",
            "format": "date-time",
