{
  "name": "digital",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && node scripts/prepare-pwa.mjs",
    "preview": "vite preview --outDir build/client",
    "dev": "react-router dev",
    "api:pull": "node scripts/pull-spec.mjs",
    "api:sync": "yarn api:pull && orval",
    "local": "orval && react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "orval": "orval",
