# Куда деплоить (используется scripts/deploy.sh)
VPS_HOST=root@1.2.3.4
VPS_DIR=/opt/app
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=TG_TOKEN
TELEGRAM_BOT_USERNAME=TG_NAME
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=4292e6765474dfef38e7965ae6befb17117324328f726f9a75288f334775d3f4
# адрес фронтенда
APP_PUBLIC_URL=http://localhost:5173
# локальная ссылка через ngrok, на фронте поменять на наш адрес
TELEGRAM_WEBHOOK_URL=https://pamperer-area-flashing.ngrok-free.dev/api/notifications/telegram/webhook

# Карта 2ГИС (RasterJS по умолчанию, MapGL — векторная со своим стилем). Фронт берёт ключ отсюда и в деве (make front), и в docker compose.
# Для MapGL ключу нужен доступ к MapGL JS API в кабинете 2ГИС (и к RasterJS для fallback).
# Для GitHub Actions — секреты VITE_2GIS_KEY, VITE_2GIS_MAP, VITE_2GIS_STYLE_ID.
VITE_2GIS_KEY=961d8ac0-76be-4473-99c0-d29e3f342529
# raster | mapgl; сравнить на одной сборке: ?map=mapgl или ?map=raster (главнее env).
VITE_2GIS_MAP=raster
# Необязательно, только MapGL: ID стиля из styles.2gis.com (Мои стили → Поделиться → Идентификатор стиля).
# Пусто — свой стиль из frontend/public/map-style (docs/map-frontend.md); RasterJS этот параметр не использует.
VITE_2GIS_STYLE_ID=

# Сервер «всё в одной папке» (/opt/app/source, make prod): те же имена томов, что у прежнего /opt/app,
# чтобы база не потерялась, и стандартные порты
# COMPOSE_PROJECT_NAME=app
# PORT=80
# HTTPS_PORT=443
# DOMAIN=example.ru

# Модерация нейросетью для make back: сначала make llm (Qwen3-1.7B на :8091), docs/moderation.md
MODERATION_LLM_ENABLED=false
